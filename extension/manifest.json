{
  "manifest_version": 3,
  "name": "Spider Crawler",
  "version": "0.6.0",
  "description": "A literal web crawler: a spider reads the page you're on and spins you the gist, figures included. Private, offline, no account.",
  "homepage_url": "https://github.com/aaronher1030-glitch/Aaron-s-Spider-crawler",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Crawl this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Crawl this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
